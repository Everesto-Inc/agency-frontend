{
  "name": "agency-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "node mock/dev.mjs",
    "build": "tsc -b && vite build",
